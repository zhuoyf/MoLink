index 0000000000000000000000000000000000000000..87ddda24c4adf306fb8f40c29232610c7bfa8954
--- /dev/null
+++ b/vllm/distributed/pp_reconfigure/adaptive/model.py
@@ -0,0 +1,242 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+import json
+import math
+from dataclasses import asdict, dataclass, field
+from pathlib import Path
+
+
+def bucket(value):
+    return 1 << max(0, math.ceil(math.log2(max(1, value))))
+
+
+@dataclass
+class Estimate:
+    value: float
+    updated: float
+    count: int = 1
+    relative_error: float = 0.0
+
+
+class PerformanceModel:
+    """Conditioned EWMA; prediction error is measured before each update."""
+
+    def __init__(self, alpha=0.2):
+        if not math.isfinite(alpha) or not 0 < alpha <= 1:
+            raise ValueError("alpha must be in (0, 1]")
+        self.alpha = alpha
+        self.estimates: dict[str, Estimate] = {}
+        self.conditions: dict = {}
+        self.compute_baseline: dict[str, float] = {}
+        self.rejected = 0
+
+    def update(self, key, observed, timestamp):
+        if not all(math.isfinite(v) and v >= 0 for v in (observed, timestamp)):
+            self.rejected += 1
+            return False
+        old = self.estimates.get(key)
+        if old and timestamp <= old.updated:
+            self.rejected += 1
+            return False
+        baseline = None
+        if key.startswith("compute/") and self.compute_baseline:
+            baseline = self._compute_curve(key, self.compute_baseline)
+        if baseline:
+            self.update(self._scale_key(key), observed / baseline, timestamp)
+        if old:
+            error = abs(old.value - observed) / max(observed, 1e-9)
+            old.relative_error = (
+                1 - self.alpha
+            ) * old.relative_error + self.alpha * error
+            old.value = (1 - self.alpha) * old.value + self.alpha * observed
+            old.updated = timestamp
+            old.count += 1
+        else:
+            self.estimates[key] = Estimate(observed, timestamp)
+        return True
+
+    def predict(self, key):
+        estimate = self.estimates.get(key)
+        return estimate.value if estimate else None
+
+    @staticmethod
+    def compute_key(stage, layers, phase, batch, context, tokens):
+        return (
+            f"compute/{stage}/{layers}/{phase}/"
+            f"{bucket(batch)}/{bucket(context)}/{bucket(tokens)}"
+        )
+
+    @staticmethod
+    def _scale_key(key):
+        parts = key.split("/")
+        return "/".join(["compute_scale", parts[1], *parts[3:]])
+
+    def freeze_compute_baseline(self):
+        self.compute_baseline = {
+            k: e.value for k, e in self.estimates.items() if k.startswith("compute/")
+        }
+        for key in self.compute_baseline:
+            self.estimates[self._scale_key(key)] = Estimate(1.0, 0)
+
+    @staticmethod
+    def _compute_curve(key, values):
+        parts = key.split("/")
+        points = [
+            (int(k.split("/")[2]), value)
+            for k, value in values.items()
+            if k.startswith(f"compute/{parts[1]}/") and k.split("/")[3:] == parts[3:]
+        ]
+        if not points:
+            return None
+        layers = int(parts[2])
+        if len(points) == 1:
+            return points[0][1] * layers / points[0][0]
+        xmean = sum(x for x, _ in points) / len(points)
+        ymean = sum(y for _, y in points) / len(points)
+        variance = sum((x - xmean) ** 2 for x, _ in points)
+        slope = max(0, sum((x - xmean) * (y - ymean) for x, y in points) / variance)
+        intercept = ymean - slope * xmean
+        if intercept < 0:
+            intercept = 0
+            slope = sum(x * y for x, y in points) / sum(x * x for x, _ in points)
+        return intercept + slope * layers
+
+    def compute(self, stage, layers, phase, batch, context, tokens):
+        key = self.compute_key(stage, layers, phase, batch, context, tokens)
+        baseline = self._compute_curve(key, self.compute_baseline)
+        if baseline is not None:
+            return baseline * (self.predict(self._scale_key(key)) or 1.0)
+        return self._compute_curve(
+            key,
+            {k: e.value for k, e in self.estimates.items() if k.startswith("compute/")},
+        )
+
+    def migration(self, key, metric):
+        exact = self.predict(key + "/" + metric)
+        if exact is not None:
+            return exact
+        _, direction, layers, size = key.split("/")
+        candidates = []
+        for name, estimate in self.estimates.items():
+            parts = name.split("/")
+            if (
+                len(parts) == 5
+                and parts[:2] == ["migration", direction]
+                and parts[4] == metric
+            ):
+                distance = abs(math.log2(int(parts[3]) / int(size))) + abs(
+                    int(parts[2]) - int(layers)
+                )
+                value = estimate.value
+                if metric != "interference":
+                    value *= int(layers) / int(parts[2])
+                    if metric == "total":
+                        bandwidth = self.predict("network/bytes_per_second")
+                        if bandwidth:
+                            value += max(0, int(size) - int(parts[3])) / bandwidth
+                candidates.append((distance, value))
+        return min(candidates)[1] if candidates else None
+
+    def save(self, path):
+        target = Path(path)
+        target.parent.mkdir(parents=True, exist_ok=True)
+        temporary = target.with_suffix(".tmp")
+        temporary.write_text(
+            json.dumps(
+                {
+                    "schema": 1,
+                    "alpha": self.alpha,
+                    "conditions": self.conditions,
+                    "compute_baseline": self.compute_baseline,
+                    "estimates": {k: asdict(v) for k, v in self.estimates.items()},
+                },
+                indent=2,
+                allow_nan=False,
+            )
+        )
+        temporary.replace(target)
+
+    @classmethod
+    def load(cls, path, conditions=None):
+        data = json.loads(Path(path).read_text())
+        if data["schema"] != 1 or (
+            conditions is not None and data["conditions"] != conditions
+        ):
+            raise ValueError("profile schema or test conditions do not match")
+        model = cls(data["alpha"])
+        model.conditions = data["conditions"]
+        for key, values in data["estimates"].items():
+            estimate = Estimate(**values)
+            if not all(
+                math.isfinite(x) and x >= 0
+                for x in (estimate.value, estimate.updated, estimate.relative_error)
+            ):
+                raise ValueError("invalid saved estimate")
+            model.estimates[key] = estimate
+        model.compute_baseline = data.get("compute_baseline", {})
+        return model
+
+
+@dataclass
+class NodeState:
+    stage: int
+    layers: int
+    memory_budget: int
+    non_kv_bytes: int
+    weight_bytes_per_layer: int
+    kv_bytes_per_layer_block: float
+    num_blocks: int
+    used_blocks: int
+    gpu_utilization: float = 0
+    block_cap: int | None = None
+    kv_payload_bytes_per_layer_block: float | None = None
+
+    kv_budget_bytes: int | None = None
+
+    @property
+    def transfer_bytes_per_block(self):
+        return (
+            self.kv_payload_bytes_per_layer_block
+            if self.kv_payload_bytes_per_layer_block is not None
+            else self.kv_bytes_per_layer_block
+        )
+
+    def __post_init__(self):
+        values = (
+            self.memory_budget,
+            self.non_kv_bytes,
+            self.weight_bytes_per_layer,
+            self.kv_bytes_per_layer_block,
+            self.num_blocks,
+            self.used_blocks,
+            self.gpu_utilization,
+        )
+        if not all(math.isfinite(x) and x >= 0 for x in values):
+            raise ValueError("invalid node measurement")
+        if (
+            self.stage not in (0, 1)
+            or self.layers <= 0
+            or self.num_blocks < 2
+            or self.kv_bytes_per_layer_block <= 0
+        ):
+            raise ValueError("invalid node layout")
+
+
+@dataclass
+class RuntimeState:
+    timestamp: float
+    version: int
+    boundary: int
+    total_layers: int
+    nodes: list[NodeState]
+    batch: int
+    context: int
+    tokens: int
+    phase: str
+    growth_blocks_per_second: float = 0
+    preemptions: int = 0
+    waiting: int = 0
+    paused: bool = False
+    activation_bytes: int = 0
+    capabilities: list = field(default_factory=list)
+    running: int | None = None
diff --git a/vllm/distributed/pp_reconfigure/adaptive/optimizer.py b/vllm/distributed/pp_reconfigure/adaptive/optimizer.py
new file mode 100644
index 0000000000000000000000000000000000000000..39f3094b06a8356256e760fe1c5a192a9c9e3508
--- /dev/null
+++ b/vllm/distributed/pp_reconfigure/adaptive/optimizer.py
@@ -0,0 +1,316 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+import math
+from dataclasses import asdict, dataclass
+
+from .model import bucket
+from .security import PlacementPlan, SecurityCostModel, SecurityPolicy
+
+
+@dataclass
+class OptimizerConfig:
+    stack_size: int = 4
+    horizon: float = 60
+    cooldown: float = 30
+    min_gain: float = 0.05
+    stale_seconds: float = 10
+    memory_reserve: int = 128 << 20
+    security_mode: str = "off"
+    admission_control: bool = True
+    admission_timeout: float = 10
+    admission_poll_interval: float = 0.25
+
+    def __post_init__(self):
+        if not all(
+            math.isfinite(x) and 0 < x <= 600
+            for x in (self.admission_timeout, self.admission_poll_interval)
+        ):
+            raise ValueError("invalid admission timeout or poll interval")
+        if self.stack_size < 1 or self.memory_reserve < (128 << 20):
+            raise ValueError("invalid stack size or memory reserve")
+        if not all(
+            math.isfinite(x) and x > 0 for x in (self.horizon, self.stale_seconds)
+        ):
+            raise ValueError("invalid horizon or staleness limit")
+        if (
+            not math.isfinite(self.cooldown)
+            or self.cooldown < 0
+            or not 0 <= self.min_gain < 1
+        ):
+            raise ValueError("invalid cooldown or gain threshold")
+
+
+class PartitionOptimizer:
+    """Compare lost service seconds over a shared horizon, including migration."""
+
+    def __init__(self, config=None):
+        self.config = config or OptimizerConfig()
+        self.last_migration = -math.inf
+        self.failed = False
+        self.security = SecurityPolicy(self.config.security_mode)
+        self.security_cost = SecurityCostModel()
+
+    @staticmethod
+    def migration_key(old, target, kv_bytes):
+        direction = "1to0" if target > old else "0to1"
+        return f"migration/{direction}/{abs(target - old)}/{bucket(kv_bytes)}"
+
+    def evaluate(self, state, model, boundary, now, *, reclaim=False):
+        cfg = self.config
+        plan = PlacementPlan(
+            boundary,
+            ("tee", "tee") if cfg.security_mode == "trusted" else ("ree", "ree"),
+            cfg.security_mode,
+        )
+        self.security.validate(plan, state.capabilities, now)
+        security_seconds = self.security_cost.cost_seconds(plan, state)
+        layers = (boundary, state.total_layers - boundary)
+        stages = [
+            model.compute(
+                n.stage,
+                layers[n.stage],
+                state.phase,
+                state.batch,
+                state.context,
+                state.tokens,
+            )
+            for n in state.nodes
+        ]
+        if any(x is None or x <= 0 for x in stages):
+            return {
+                "boundary": boundary,
+                "valid": False,
+                "reason": "missing_compute_bucket",
+            }
+        bandwidth = model.predict("network/bytes_per_second")
+        latency = model.predict("network/latency_seconds")
+        if not bandwidth or latency is None:
+            return {
+                "boundary": boundary,
+                "valid": False,
+                "reason": "missing_network_profile",
+            }
+        capacities, peaks = [], []
+        moving_bytes = 0
+        for node in state.nodes:
+            target = layers[node.stage]
+            incoming = max(0, target - node.layers)
+            final_non_kv = (
+                node.non_kv_bytes + (target - node.layers) * node.weight_bytes_per_layer
+            )
+            per_block = target * node.kv_bytes_per_layer_block
+            capacity = max(
+                0,
+                int(
+                    (node.memory_budget - final_non_kv - cfg.memory_reserve) / per_block
+                ),
+            )
+            if node.kv_budget_bytes is not None:
+                capacity = min(capacity, int(node.kv_budget_bytes / per_block))
+            if node.block_cap is not None:
+                capacity = min(capacity, node.block_cap)
+            if boundary == state.boundary:
+                capacity = min(capacity, node.num_blocks)
+            capacities.append(capacity)
+            # Address-based KV pools coexist only for the union of owned layers.
+            peak = (
+                node.non_kv_bytes
+                + incoming * node.weight_bytes_per_layer
+                + max(target, node.layers)
+                * node.kv_bytes_per_layer_block
+                * node.num_blocks
+                + cfg.memory_reserve
+            )
+            peaks.append(peak)
+            if incoming:
+                moving_bytes = (
+                    incoming * node.transfer_bytes_per_block * node.used_blocks
+                )
+            if reclaim and boundary != state.boundary:
+                # Only test whether an empty pool could fit; the executor still
+                # requires measured physical capacity before any migration.
+                peak = (
+                    node.non_kv_bytes
+                    + incoming * node.weight_bytes_per_layer
+                    + max(target, node.layers) * node.kv_bytes_per_layer_block * 2
+                    + cfg.memory_reserve
+                )
+            if boundary != state.boundary and peak > node.memory_budget:
+                return {
+                    "boundary": boundary,
+                    "valid": False,
+                    "reason": "intermediate_memory",
+                    "peak_bytes": peaks,
+                }
+        capacity = min(capacities)
+        used = max(n.used_blocks for n in state.nodes)
+        projected = (
+            used
+            + max(0, state.growth_blocks_per_second) * cfg.horizon
+            + state.waiting
+            * math.ceil(state.context / model.conditions.get("block_size", 16))
+        )
+        # Risk is a proxy for lost service, separate from measured preemptions.
+        risk = min(1.0, max(0, projected - capacity + 1) / max(1, projected))
+        if boundary != state.boundary and capacity <= (1 if reclaim else used):
+            return {
+                "boundary": boundary,
+                "valid": False,
+                "reason": "target_kv_capacity",
+            }
+        concurrent = (state.running if state.running is not None else state.batch) > 1
+        compute_ms = (
+            max(stages) if state.phase == "decode" and concurrent else sum(stages)
+        )
+        step_seconds = compute_ms / 1000 + latency + state.activation_bytes / bandwidth
+        total = pause = interference = 0.0
+        if boundary != state.boundary:
+            key = self.migration_key(state.boundary, boundary, moving_bytes)
+            values = [
+                model.migration(key, metric)
+                for metric in ("total", "pause", "interference")
+            ]
+            if any(v is None for v in values):
+                return {
+                    "boundary": boundary,
+                    "valid": False,
+                    "reason": "missing_migration_profile",
+                    "key": key,
+                }
+            total, pause, interference = values
+            total = max(total, pause)
+        phase_predictions = {}
+        for phase in ("prefill", "decode"):
+            phase_times = [
+                model.compute(
+                    n.stage,
+                    layers[n.stage],
+                    phase,
+                    state.batch,
+                    state.context,
+                    state.tokens if phase == "prefill" else state.batch,
+                )
+                for n in state.nodes
+            ]
+            phase_predictions[phase] = (
+                (
+                    max(phase_times)
+                    if phase == "decode" and concurrent
+                    else sum(phase_times)
+                )
+                / 1000
+                if all(t is not None for t in phase_times)
+                else None
+            )
+        return {
+            "phase_predictions_seconds": phase_predictions,
+            "boundary": boundary,
+            "valid": True,
+            "step_seconds": step_seconds,
+            "capacity_blocks": capacity,
+            "projected_blocks": projected,
+            "risk": risk,
+            "peak_bytes": peaks,
+            "migration_total": total,
+            "migration_pause": pause,
+            "interference": interference,
+            "security_seconds": security_seconds,
+        }
+
+    def decide(
+        self, state, model, now, *, reclaim=False, gate_wait=0, queue_seconds=None
+    ):
+        result = {
+            "state": asdict(state),
+            "candidates": [],
+            "target": state.boundary,
+            "version": state.version,
+            "reason": "hold",
+        }
+        if (
+            self.failed
+            or state.paused
+            or not 0 <= now - state.timestamp <= self.config.stale_seconds
+        ):
+            result["reason"] = "failure_latched" if self.failed else "paused_or_stale"
+            return result
+        if len(state.nodes) != 2 or {n.stage for n in state.nodes} != {0, 1}:
+            result["reason"] = "missing_nodes"
+            return result
+        if not state.waiting and (
+            state.running == 0
+            or (state.running is None and all(n.used_blocks == 0 for n in state.nodes))
+        ):
+            result["reason"] = "idle"
+            return result
+        if now - self.last_migration < self.config.cooldown:
+            result["reason"] = "cooldown"
+            return result
+        for boundary in range(
+            self.config.stack_size, state.total_layers, self.config.stack_size
+        ):
+            try:
+                candidate = self.evaluate(state, model, boundary, now, reclaim=reclaim)
+            except ValueError as exc:
+                candidate = {"boundary": boundary, "valid": False, "reason": str(exc)}
+            result["candidates"].append(candidate)
+        current = next(
+            (
+                c
+                for c in result["candidates"]
+                if c["boundary"] == state.boundary and c["valid"]
+            ),
+            None,
+        )
+        if current is None:
+            result["reason"] = "current_prediction_unavailable"
+            return result
+        for c in result["candidates"]:
+            if c["valid"]:
+                # The old placement serves until commit; gains start afterwards.
+                transition = min(self.config.horizon, c["migration_total"])
+                steady = self.config.horizon - transition
+                pause = min(transition, c["migration_pause"])
+                c["cost_seconds"] = (
+                    transition * (1 + current["risk"])
+                    + steady * (c["step_seconds"] / current["step_seconds"] + c["risk"])
+                    + pause
+                    + max(0, transition - pause) * c["interference"]
+                    + c["security_seconds"]
+                    + (
+                        gate_wait
+                        + (
+                            gate_wait * state.waiting
+                            if queue_seconds is None
+                            else queue_seconds
+                        )
+                        / max(1, state.running or state.batch)
+                        if c["boundary"] != state.boundary
+                        else 0
+                    )
+                )
+        errors = [
+            e.relative_error
+            for k, e in model.estimates.items()
+            if k.startswith("compute/")
+            and k.split("/")[3:]
+            == model.compute_key(
+                0, 1, state.phase, state.batch, state.context, state.tokens
+            ).split("/")[3:]
+        ]
+        result["model_relative_error"] = max(errors, default=0)
+        best = min(
+            (c for c in result["candidates"] if c["valid"]),
+            key=lambda c: c["cost_seconds"],
+        )
+        gain = (current["cost_seconds"] - best["cost_seconds"]) / current[
+            "cost_seconds"
+        ]
+        result["gain"] = gain
+        if best["boundary"] != state.boundary and gain >= self.config.min_gain + min(
+            0.5, result["model_relative_error"] * 0.1
+        ):
+            result.update(target=best["boundary"], reason="expected_service_gain")
+        else:
+            result["reason"] = "insufficient_gain"
+        return result
diff --git a/vllm/distributed/pp_reconfigure/adaptive/runtime.py b/vllm/distributed/pp_reconfigure/adaptive/runtime.py
